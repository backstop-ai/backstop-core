# bclabs-portal — environment surface (ISSUE-006 / go-live).
# Copy to `.env.local` (gitignored) for local dev, or set as Vercel project env vars for deploy.
# Legend: [S] secret (server-only, never browser-exposed)  [P] public/non-secret config
#         [R] runtime-provided by the platform — do NOT set these yourself.
# Full provisioning procedure + per-var source: docs/go-live-scaffolding.md §2-§3.

# ── Supabase (data + auth + storage) ────────────────────────────────────────
SUPABASE_URL=                      # [P] Supabase project URL (dashboard / `supabase projects api-keys`)
SUPABASE_ANON_KEY=                 # [P] Supabase anon/publishable key (browser-public; used by the @supabase/ssr login client)
SUPABASE_SERVICE_ROLE_KEY=         # [S] Supabase service-role key (server-only write path; bypasses RLS)
DATABASE_URL=                      # [S] Supavisor TRANSACTION pooler string (port 6543) — MUST include prepare=false

# ── Cron (Vercel scheduled reconcile) ───────────────────────────────────────
CRON_SECRET=                       # [S] generated; Vercel Cron sends it as a Bearer token to /api/reconcile

# ── Ingest webhook HMAC secrets (shared with each sender) ────────────────────
PORTAL_PUSH_SECRET=                # [S] HMAC secret for the push webhook
PORTAL_PR_SECRET=                  # [S] HMAC secret for the PR webhook
PORTAL_DEPLOY_SECRET=              # [S] HMAC secret for the deploy webhook

# ── Artifact-repo corpus fetch (serverless, no checkout) ─────────────────────
PORTAL_GITHUB_TOKEN=               # [S] GitHub App/PAT for artifact-repo fetch
PORTAL_ARTIFACT_REPO=              # [P] artifact repo identity, e.g. owner/repo
PORTAL_DEFAULT_BRANCH=main         # [P] default branch

# ── CI OIDC ingest hardening (GitHub Actions attested delivery) ──────────────
PORTAL_OIDC_AUDIENCE=              # [P] chosen audience; MUST match the emitter workflow's vars.PORTAL_OIDC_AUDIENCE
PORTAL_OIDC_ISSUER=https://token.actions.githubusercontent.com   # [P] GitHub constant
PORTAL_OIDC_JWKS_URL=https://token.actions.githubusercontent.com/.well-known/jwks   # [P] GitHub Actions JWKS (constant)
PORTAL_OIDC_REPOSITORY=            # [P] allowed repo for OIDC ingest (e.g. bclabs/portal)
PORTAL_INGEST_URL=                 # [P] the deployed portal's ingest endpoint (also a repo var on the emitter side)

# ── Cohort pins (false-green defense) ────────────────────────────────────────
PORTAL_EXPECTED_BACKSTOP_VERSION=  # [P] expected backstop version cohort
PORTAL_EXPECTED_SCHEMA_COHORT=     # [P] expected schema cohort
PORTAL_SCHEMA_COHORT=              # [P] schema cohort value

# ── Telemetry (PostHog) — optional; finite billing caps applied if unset ─────
POSTHOG_PROJECT_KEY=               # [P] PostHog project public key
POSTHOG_HOST=https://us.i.posthog.com   # [P] PostHog host
POSTHOG_MAX_EVENTS=                # [P] hard billing cap (events)
POSTHOG_MAX_EXCEPTIONS=            # [P] hard billing cap (exceptions)

# ── Runtime-provided — do NOT set (documented for reference only) ────────────
# NEXT_RUNTIME          [R] set by Next per runtime; the composition root inits only when "nodejs"
# GITHUB_REF / GITHUB_REPOSITORY / GITHUB_RUN_ID / GITHUB_SHA   [R] provided by GitHub Actions on the emitter side

# ── Possibly vestigial (verify before treating as required) ──────────────────
# PORTAL_OIDC_SIGNING_KEY   the HMAC path Seed 5 removed
# PORTAL_REPO_PATH          the reconcile repoPath, ignored by the serverless reader
