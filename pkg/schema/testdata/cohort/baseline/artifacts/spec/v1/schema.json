{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cohort-fixture-spec-v1",
  "title": "Cohort Fixture Spec Schema v1",
  "version": "1.0.0",
  "extends": "cohort-fixture-base-v1",
  "artifact_type": "spec",
  "filename_pattern": "^SPEC-[0-9]{3}-[a-z0-9-]+\\.spec\\.md$",
  "metadata": {
    "required": ["title", "number", "created", "status", "schema_version"],
    "properties": {
      "number": { "pattern": "^SPEC-[0-9]{3}$" },
      "schema_version": { "const": "spec/v1" }
    }
  },
  "required_sections": ["Overview"]
}
