{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cohort-fixture-base-v1",
  "title": "Cohort Fixture Base Schema",
  "version": "1.1.0",
  "type": "object",
  "required": ["filename_pattern", "metadata", "required_sections"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["title", "number", "created", "status", "schema_version", "owner"],
      "properties": {
        "title": { "type": "string", "minLength": 5 },
        "number": { "type": "string" },
        "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "status": { "type": "string" },
        "schema_version": { "type": "string", "pattern": "^[a-z]+/v[0-9]+$" },
        "owner": { "type": "string" }
      }
    }
  },
  "required_sections": ["Overview"]
}
