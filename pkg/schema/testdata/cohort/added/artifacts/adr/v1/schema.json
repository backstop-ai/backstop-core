{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cohort-fixture-adr-v1",
  "title": "Cohort Fixture ADR Schema v1",
  "version": "1.0.0",
  "extends": "cohort-fixture-base-v1",
  "artifact_type": "adr",
  "filename_pattern": "^ADR-[0-9]{4}-[a-z0-9-]+\\.adr\\.md$",
  "metadata": {
    "required": ["title", "number", "created", "status", "schema_version"],
    "properties": {
      "number": { "pattern": "^ADR-[0-9]{4}$" },
      "schema_version": { "const": "adr/v1" }
    }
  },
  "required_sections": ["Context"]
}
