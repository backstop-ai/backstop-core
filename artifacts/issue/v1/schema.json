{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "backstop-issue-v1",
  "title": "Backstop Issue Schema v1",
  "description": "Schema for issues — lightweight sister artifact to specs. Supports bug fixes, enhancements, and technical debt tracking with optional claims validated on close. Extends backstop-artifact-base-v1.",
  "version": "1.0.0",
  "extends": "backstop-artifact-base-v1",
  "artifact_type": "issue",
  "filename_pattern": "^ISSUE-[0-9]{3}-[a-z][a-z0-9]*(-[a-z0-9]+)*\\.md$",
  "slug_pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
  "slug_min_length": 2,
  "slug_max_length": 64,
  "metadata": {
    "required": ["title", "schema_version"],
    "properties": {
      "schema_version": {
        "const": "issue/v1"
      }
    }
  },
  "required_sections": [
    "Problem"
  ],
  "optional_sections": [
    "Solution",
    "Verification",
    "Resolution",
    "References"
  ],
  "nested_blocks": {
    "issue": {
      "type": "object",
      "description": "Core issue identity and lifecycle",
      "required_keys": ["id", "title", "type", "status", "created"],
      "properties": {
        "id": {
          "pattern": "^ISSUE-[0-9]{3}$",
          "description": "Issue identifier"
        },
        "type": {
          "enum": ["bug", "technical-debt", "enhancement", "question", "policy-violation"]
        },
        "status": {
          "enum": ["open", "in-progress", "blocked", "closed"]
        },
        "created": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "closed": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Required when status is 'closed'"
        }
      }
    },
    "complexity": {
      "type": "object",
      "description": "Optional complexity assessment",
      "properties": {
        "scope": {
          "enum": ["isolated", "contained", "cross-cutting"]
        },
        "uncertainty": {
          "enum": ["known", "exploratory", "novel"]
        },
        "risk": {
          "enum": ["safe", "moderate", "critical"]
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Acceptance criteria claims — optional but validated when status is 'closed'",
      "item_required_keys": ["id", "text"],
      "properties": {
        "id": {
          "pattern": "^AC-[0-9]{3}\\.[0-9]+$",
          "description": "Acceptance criterion ID (e.g., AC-001.1)"
        }
      }
    }
  },
  "enforcement": {
    "blocked-requires-blocked-by": "Issues with status 'blocked' must have non-empty context.blocked_by array",
    "closed-requires-date": "Issues with status 'closed' must have issue.closed date",
    "claims-validated-on-close": "Claims array validated (id pattern, non-empty text) only when status is 'closed'",
    "id-filename-consistency": "issue.id must match the ISSUE-NNN prefix in the filename"
  }
}
